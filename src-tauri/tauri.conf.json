{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Desktop Companion",
  "version": "0.1.0",
  "identifier": "dev.agentdesktopcompanion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Agent Desktop Companion",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "pet",
        "title": "Glint",
        "width": 180,
        "height": 210,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": true,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "pet-menu",
        "title": "Glint Menu",
        "width": 128,
        "height": 192,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.agent-desktop-companion/pets/**",
          "$HOME/.claude-sprout/pets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
