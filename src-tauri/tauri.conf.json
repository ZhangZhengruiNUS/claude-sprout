{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Sprout",
  "version": "0.1.0",
  "identifier": "dev.claudesprout.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Claude Sprout",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "pet",
        "title": "Claude Sprout Pet",
        "width": 180,
        "height": 210,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.claude-sprout/pets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
