{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Claude Sprout windows",
  "windows": ["main", "pet"],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "notification:default",
    "opener:default",
    "window-state:default"
  ]
}
